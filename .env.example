# Public site URL used for canonical tags, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.thirteenmonth.technology

# Shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=contact@thirteenmonth.technology

# Destination for contact form submissions.
CONTACT_TO_EMAIL=contact@thirteenmonth.technology

# Optional: send form submissions through Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Thirteen Month Technology <noreply@thirteenmonth.technology>

# Optional privacy-friendly analytics (Plausible).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.thirteenmonth.technology
